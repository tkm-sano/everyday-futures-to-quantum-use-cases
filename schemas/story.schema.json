{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "story"
  ],
  "properties": {
    "story": {
      "type": "object",
      "required": [
        "id",
        "scenario_year",
        "status",
        "central_person_count"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "scenario_year": {
          "const": 2055
        },
        "status": {
          "enum": [
            "draft",
            "reviewed",
            "approved"
          ]
        },
        "central_person_count": {
          "const": 1
        }
      },
      "additionalProperties": true
    }
  }
}
